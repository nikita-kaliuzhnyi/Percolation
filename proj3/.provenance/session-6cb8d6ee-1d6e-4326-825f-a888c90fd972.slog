4\n26  6\n45 20\n 5 90\n71 58\n26 42\n68 64\n73 96\n 8 66\n74 52\n63 70\n57 96\n76 14\n11 20\n59 24\n62 22\n87 68\n21 30\n91 96\n23  4\n68 46\n66 10\n94  2\n47 16\n75 54\n25 60\n15 16\n71 24\n39 12\n87 44\n87  0\n51 72\n53 62\n74 24\n97 96\n64 28\n26 34\n82 98\n35 70\n88 64\n14 58\n46  0\n80 86\n45 78\n89 28\n68  2\n22 56\n40 30\n28 76\n 9 26\n42  6\n70 94\n39 72\n51 62\n24 12\n98 86\n64 40\n82 28\n13 74\n17 100\n43 48\n75 14\n47 72\n 5 50\n92 46\n92 24\n59 76\n40 20\n83 10\n39 28\n57 46\n78 28\n78 90\n72 62\n82 42\n34 12\n71 14\n 4 14\n55 10\n28 74\n36 74\n 7  8\n96 24\n45 14\n71 74\n74 100\n61 44\n82 100\n17 92\n61 16\n58 74\n73 88\n67 34\n96 64\n31 46\n46 100\n63 100\n67 92\n73 62\n94 42\n74 94\n75 50\n20 18\n73 22\n29  6\n85  8\n35 60\n 4 34\n33 52\n57 70\n94 70\n43 80\n67 100\n57 54\n94 38\n39 64\n12 20\n42  4\n84 82\n56 14\n18 72\n94 92\n83 96\n42 70\n78 58\n45 100\n79 18\n23 66\n97 44\n60 26\n45 86\n44 22\n38 50\n29 10\n33 48\n31 38\n65 46\n79 40\n26 70\n88 56\n45 66\n80 24\n15 72\n24 54\n42 82\n24 40\n61 18\n 1 94\n33 74\n50 14\n90 38\n32 78\n12 94\n51 16\n83 98\n83 46\n23 30\n79 12\n96 46\n90 52\n61 22\n62 74\n98 34\n89 10\n49 20\n30 94\n25 88\n26 20\n18 24\n62 70\n34 80\n60 48\n94 100\n22 76\n60 50\n44 60\n92 86\n38 58\n35 54\n95 50\n20 92\n86 42\n18 44\n46 32\n29 14\n62 14\n16 10\n34 76\n22 30\n50 18\n16 30\n11 42\n75 44\n25 78\n85  0\n41 70\n24 44\n40  4\n33 18\n83 28\n23 14\n39 94\n16 92\n37 80\n98 46\n42 38\n86 64\n92 34\n10 12\n50 22\n11 28\n54 34\n72 66\n 9 96\n66  4\n88 52\n69 62\n34  8\n81 36\n99 81\n 7 28\n 4 30\n32 50\n52 36\n78 66\n 9 18\n86 30\n35 62\n79 26\n84 70\n42 66\n95 54\n89 16\n43  0\n78 72\n54 60\n43  2\n75 98\n34 28\n72 12\n83 36\n78 54\n20 22\n91 42\n97 66\n25 90\n13 34\n42 98\n49 82\n37 58\n99 74\n62 46\n62 58\n41 96\n59  2\n 7 10\n 3 30\n20 24\n37 70\n100 100 0  0","line_count":5101,"path":"inputFiles/snake101.txt","sha256":"90d4e27d8742378ebe29345a88de101585622f513e4472e3438d6c4c3d66e16d"},"hash":"e315e9f917f163a0baf2597763ea4e79c